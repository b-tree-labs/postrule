# Production-build env vars for the Postrule dashboard.
#
# Next.js loads `.env.production` automatically when NODE_ENV=production
# (which is what OpenNext's `opennextjs-cloudflare build` does), so the
# NEXT_PUBLIC_* values below are inlined into the JS bundle at build
# time and the build no longer requires a hand-curated `.env.local`
# on each operator's machine.
#
# RULES:
# - Only NEXT_PUBLIC_* values belong here (Next.js convention: anything
#   prefixed NEXT_PUBLIC_ is intentionally exposed to the browser bundle).
# - Secrets (CLERK_SECRET_KEY, STRIPE_SECRET_KEY, POSTRULE_API_SERVICE_TOKEN)
#   never go here. They live in the Worker secret store (`wrangler secret put`)
#   and are read at runtime via process.env.<NAME> from the Worker, NOT
#   from this file.
# - Values must mirror cloud/dashboard/wrangler.jsonc `vars` block for
#   the SAME NAMES. If you change one, change the other in the same PR.
# - `.env.production.local` (gitignored) can still be used for per-machine
#   overrides, but the default-case build needs nothing more than this file.

# Clerk publishable production-instance key. Public by design (front-end
# token). Decoded suffix → `clerk.postrule.ai$` = the prod FAPI host.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_live_Y2xlcmsucG9zdHJ1bGUuYWkk

# Clerk redirect paths. Identical to defaults but explicit for clarity.
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard

# Public dashboard URL for CLI redirect generation in /api/cli-auth.
NEXT_PUBLIC_DASHBOARD_URL=https://app.postrule.ai
